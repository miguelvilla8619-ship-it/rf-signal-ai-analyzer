# API Configuration
API_PORT=5000
API_HOST=localhost
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/rf-signal-analyzer
REDIS_URL=redis://localhost:6379

# ML Model
MODEL_PATH=./models/threat_model.pkl
TENSORFLOW_MODEL_PATH=./models/signal_classifier.h5

# Signal Processing
RTL_SDR_DEVICE_ID=0
SAMPLE_RATE=2000000
CENTER_FREQUENCY=2400000000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
